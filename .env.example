# LUFLY Catalog - Example Configuration
# Copy this file to .env and fill in your values
# DO NOT commit the .env file (it contains passwords)

# Database Settings (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lufly_catalog
DB_USERNAME=root
DB_PASSWORD=

# Application Password (required to access the system)
APP_PASSWORD=

# Optional offline AI enhancement: absolute path to the Python venv executable
ENHANCEMENT_PYTHON=
# Optional EDSR x4 model path (outside the web root is recommended)
ENHANCEMENT_X4_MODEL=

# auto: loopback/CLI -> protected JSON files; hosted -> database
# Pin APP_STORAGE=database on production (especially behind a reverse proxy).
APP_STORAGE=auto
DB_DRIVER=mysql
