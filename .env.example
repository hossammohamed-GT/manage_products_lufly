# LUFLY Catalog - Example Configuration
# Copy this file to .env and fill in your values
# DO NOT commit the .env file (it contains passwords)

# Database Settings (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lufly_catalog
DB_USERNAME=root
DB_PASSWORD=

# Storage mode: auto = local JSON files on localhost/CLI, database on hosting.
# Use files to force local JSON mode, database to force MySQL/SQLite (set this on hosting).
APP_STORAGE=auto

# Database driver when a database is used (mysql or sqlite)
DB_DRIVER=mysql

# Application Password (required to access the system)
APP_PASSWORD=
